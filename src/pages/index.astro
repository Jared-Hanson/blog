---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPublishedPosts } from "../lib/posts";

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 6);
---

<BaseLayout
  title="Jareds Thoughts"
  description="A simple blog for essays, notes, and ideas written in Markdown."
>
  <section class="home-intro">
    <h1>Jareds Thoughts</h1>
    <p class="lede">
      My attempt at stretching my brain through writing.
    </p>
  </section>

  <section class="home-section-header">
    <h2>Recent posts</h2>
    <a href="/archive">See the full index</a>
  </section>

  <section class="post-grid">
    {recentPosts.map((post) => (
      <PostCard
        href={`/posts/${post.id}/`}
        title={post.data.title}
        description={post.data.description}
        date={post.data.date}
        updated={post.data.updated}
        tags={post.data.tags}
      />
    ))}
  </section>
</BaseLayout>
